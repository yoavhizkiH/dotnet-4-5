<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Target Framework and Output Configuration -->
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>SimpleApp</RootNamespace>
    <AssemblyName>SimpleApp</AssemblyName>

    <!-- Language Configuration -->
    <LangVersion>12</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>

    <!-- Assembly Metadata (migrated from Properties/AssemblyInfo.cs) -->
    <AssemblyTitle>SimpleApp</AssemblyTitle>
    <Description>A simple .NET 8.0 console application</Description>
    <Product>SimpleApp</Product>
    <Copyright>Copyright © 2024</Copyright>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0</FileVersion>
  </PropertyGroup>

</Project>
